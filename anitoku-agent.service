# systemd unit — copy to /etc/systemd/system/anitoku-agent.service
# sudo systemctl daemon-reload && sudo systemctl enable --now anitoku-agent
[Unit]
Description=ANITOKU Support Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anitoku
WorkingDirectory=/opt/anitoku-agent
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=TZ=Asia/Tashkent
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anitoku-agent

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/anitoku-agent/data

[Install]
WantedBy=multi-user.target
