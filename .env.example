# ─────────────────────────────────────────────
#  ANITOKU SUPPORT AGENT — environment
# ─────────────────────────────────────────────

# Admin panel
ADMIN_PORT=8787
ADMIN_HOST=127.0.0.1
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# Master secret used to encrypt Telegram sessions + AI keys at rest (AES-256-GCM).
# MUST be set and MUST NOT change after first run, otherwise stored secrets are unreadable.
APP_SECRET=

# Optional: trust reverse proxy (set 1 when behind nginx/caddy)
TRUST_PROXY=0

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# Timezone for schedules / reports
TZ=Asia/Tashkent
