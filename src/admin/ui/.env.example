# ============================================
# ANITOKU — panel muhiti
# ============================================
# API panel bilan bir xil origin'da (Express /api) — shuning uchun
# nisbiy manzil. Dev serverda package.json dagi "proxy" uni 8787 ga
# uzatadi, production'da esa panelning o'zi shu serverdan beriladi.
REACT_APP_API_BASE_URL=/api
REACT_APP_API_TIMEOUT=20000

REACT_APP_NAME=ANITOKU
REACT_APP_VERSION=1.0.0
